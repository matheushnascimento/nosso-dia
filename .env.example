# Copie para .env.local e preencha.
# Local: os valores aparecem em `npx supabase status` depois de `npx supabase start`.
# Remoto: Supabase Dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Chave publicável (sb_publishable_...). A "anon key" antiga também funciona aqui.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# URL pública do app, usada nos links de e-mail (confirmação, nova senha, convite).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Opcional: envio do convite de parceiro por e-mail via Resend.
# Sem isso, o app mostra o link do convite para copiar.
RESEND_API_KEY=
EMAIL_REMETENTE="Nosso Dia <convites@seudominio.com.br>"
