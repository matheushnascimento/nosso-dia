# Copie para .env.local e preencha.

# Banco Postgres. Local: o do `npm run db:start` (compose.yaml).
# Neon: a conexão com pooler. Para migrations, prefira a direta em DATABASE_URL_UNPOOLED
# (a integração do Neon na Vercel cria as duas).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54320/nosso_dia

# Supabase: ainda usado pelo app até a migração para o Better Auth (#26) e o SQL direto (#27).
# Local: os valores aparecem em `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Chave publicável (sb_publishable_...) ou a "anon key" antiga, colada aqui.
# NEXT_PUBLIC_SUPABASE_ANON_KEY também é aceito como nome alternativo.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# URL pública do app, usada nos links de e-mail (confirmação, nova senha, convite).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Só para `npm run dev` acessado de outro computador (ex.: servidor de casa pelo IP).
# Hostnames separados por vírgula, sem http:// e sem porta. Ajuste NEXT_PUBLIC_SITE_URL para o mesmo endereço.
DEV_ORIGINS=

# "1" mostra a página em construção (public/em-construcao.html) em todas as rotas.
# Ela também aparece automaticamente quando as variáveis do Supabase acima estão vazias.
EM_CONSTRUCAO=

# Opcional: envio do convite de parceiro por e-mail via Resend.
# Sem isso, o app mostra o link do convite para copiar.
RESEND_API_KEY=
EMAIL_REMETENTE="Nosso Dia <convites@seudominio.com.br>"
