{
  "name": "nosso-dia",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:start": "docker compose up -d --wait db",
    "db:stop": "docker compose stop db",
    "db:migrate": "node scripts/db.mjs migrar",
    "db:status": "node scripts/db.mjs status",
    "db:reset": "node scripts/db.mjs resetar",
    "db:test": "docker compose exec -T -u postgres -e PGHOST=/var/run/postgresql db /nosso-dia/db/testes/rodar.sh"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "better-auth": "^1.7.28",
    "kysely": "^0.29.9",
    "kysely-postgres-js": "^5.1.0",
    "next": "16.4.6",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
}
